# Ekshop Site Sentinel configuration — never commit a real .env file.
# Copy this to .env and set your deployment values.

# The base URL of the Ekshop API (required).
# Example: http://localhost:8000 or https://ekshop.example.com
SENTINEL_API_URL=http://localhost:8000

# Optional: email address for canary alert notifications.
# CANARY_EMAIL=ops-team@example.com

# Feature toggles (set to 1 or true to enable).
# CAN_ENABLE_ATTESTATION=1     # interaction-entropy attestation
# CAN_ENABLE_EGRESS=1          # outbound egress monitor (mitmproxy)

# The Ed25519 secret key used to verify beacon signatures.
# Generate with: python -c "import base64, nacl; print(base64.b64encode(nacl.signing.SigningKey.generate().seed).decode())"
# SECRET_KEY=base64_encoded_32_byte_seed